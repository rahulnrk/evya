# CMS (Vite) — copy to .env.local for local overrides (gitignored by default if you add .env*)

# Backend API
VITE_BASE_URL=http://localhost:8800
# Production example: https://server.evyaa.com

# OCPP admin API
VITE_BASE_OCPP_URL=https://ocpp.evyaa.com

# EvyaSense / alerts
VITE_BASE_ALERTS_URL=http://localhost:8080/

# OCPI gateway (Roaming tab). Authenticated with the operator's login token.
VITE_BASE_OCPI_URL=http://localhost:8082

VITE_ORGANIZATION_ID=1

# Google Maps (LocationPicker)
VITE_GOOGLE_MAPS_API_KEY=

# Optional cosmetic
# VITE_BACKGROUND_IMAGE_HOME=url('https://example.com/bg.jpg')
