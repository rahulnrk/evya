# EVYA log shipper. Copy to .env and fill in; never commit real values.

# Must match the CSMS file.logsLocation setting.
SHIPPER_ROOT=/home/ubuntu/logs/stationLogs
SHIPPER_TOPIC=evya-sense-topic
SHIPPER_STATE_FILE=/var/lib/evya-log-shipper/shipper-state.properties
SHIPPER_POLL_INTERVAL_MS=2000
# Set false once, to backfill an existing log directory.
SHIPPER_START_AT_END=true

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
