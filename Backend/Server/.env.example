# Backend/Server — copy to environment or set before `java -jar` / IDE run config.
# Do NOT commit real values. Previously committed secrets must be ROTATED by the owner.

SERVER_PORT=8800
HTTP_PORT=8211

# JWT — REQUIRED at startup (min 32 chars). Do NOT use a placeholder or known default.
# Generate: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=86400000

# OTP store: set true + run Redis for multi-instance
OTP_USE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://portal.evyaa.com

# SQL Server (database: evya)
DB_DRIVER=com.microsoft.sqlserver.jdbc.SQLServerDriver
DB_URL=jdbc:sqlserver://HOST:1433;databaseName=evya;encrypt=true;trustServerCertificate=true
DB_USER=
DB_PASSWORD=

JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Payments
PHONEPE_AUTH_URL=https://api-preprod.phonepe.com/apis/pg-sandbox/v1/oauth/token
PHONEPE_PAY_URL=https://api-preprod.phonepe.com/apis/pg-sandbox/checkout/v2/pay
PHONEPE_STATUS_URL=https://api-preprod.phonepe.com/apis/pg-sandbox/checkout/v2/order
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1

RAZORPAY_KEY_ID=
RAZORPAY_SECRET_KEY=

# SMS / email
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SMTP_DEBUG=false

# Integrations
GOOGLE_MAPS_API_KEY=
GROK_API_KEY=
GROK_API_URL=https://api.x.ai/v1/chat/completions

ADMIN_EMAIL=
ADMIN_NAME=Admin
RFID_UNIT_PRICE=300

HIBERNATE_SEARCH_INDEX_BASE=C:/hibernate/lucence/indexes
