# EVYA OCPI gateway — copy to .env and fill in. Never commit real values (CLAUDE.md ground rule 4).

OCPI_PORT=8082
OCPI_PUBLIC_BASE_URL=https://ocpi.example.test

OCPI_DB_URL=jdbc:mysql://localhost:3307/ocpi_db?createDatabaseIfNotExist=true
OCPI_DB_USER=
OCPI_DB_PASSWORD=

# 32 random bytes, base64 — encrypts partner tokens at rest.
#   openssl rand -base64 32
# Losing this key means every partner connection must be re-registered.
OCPI_TOKEN_KEY=

# The business API's operator JWT secret (ADR-003). The portal OCPI tab authenticates with it, so it
# must match the backend's and OCPP's JWT_SECRET. Startup fails if unset.
PLATFORM_JWT_SECRET=
# The platform admin role id (portal convention: 1).
PLATFORM_ROLE_ADMIN=1
